# Install as /etc/nur/storage-hygiene.env with mode 0600.
# This role must be dedicated to maintenance and hold BYPASSRLS. Never use nur_app.
NUR_STORAGE_HYGIENE_DATABASE_URL=postgresql+asyncpg://nur_storage_maintenance:REPLACE_ME@localhost:5432/nur
NUR_STORAGE_HYGIENE_OBJECT_ROOT=/var/lib/nur/project-objects
NUR_STORAGE_HYGIENE_DELETE_ORPHANS=false
NUR_STORAGE_HYGIENE_RETENTION_SECONDS=604800
